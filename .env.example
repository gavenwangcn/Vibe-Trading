# Docker Compose 变量（复制为项目根 .env：cp .env.example .env）
#
# --- 端口发布 ---
# 服务器对外访问（默认）：
VIBE_PUBLISH=8899
#
# 仅本机访问（开发机）：
# VIBE_PUBLISH=127.0.0.1:8899
#
# 前端开发 profile 对外端口（docker compose --profile frontend up）
# VIBE_FRONTEND_PUBLISH=5899
#
# --- 微信桥多实例（可选）---
# WECHAT_DATA_ROOT=./wechat-instances
# WECHAT_INSTANCE_NAME=default
